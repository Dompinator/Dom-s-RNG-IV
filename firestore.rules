rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email.lower() == 'codompic@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidRollPoolAura(data, auraId) {
      return data.keys().hasAll([
          'id', 'name', 'description', 'enabled', 'baseOdds',
          'classification', 'authorUid', 'project', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'description', 'enabled', 'baseOdds',
          'classification', 'authorUid', 'project', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == auraId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 64
        && data.description is string && data.description.size() <= 240
        && data.enabled is bool
        && data.baseOdds is number && data.baseOdds >= 1 && data.baseOdds <= 1000000000000
        && data.classification in ['Common', 'Uncommon', 'Rare', 'Epic', 'Legendary', 'Mythic']
        && isValidId(data.authorUid)
        && data.project is map
        && data.project.keys().hasAll(['id', 'name', 'layers', 'rarity'])
        && data.project.layers is list && data.project.layers.size() <= 64
        && (data.project.layers.size() == 0 || data.project.layers[0] is map)
        && (!('audio' in data.project) || (
          data.project.audio is map
          && data.project.audio.dataUrl is string
          && data.project.audio.dataUrl.size() <= 920000
          && data.project.audio.fileName is string
          && data.project.audio.fileName.size() <= 96
        ))
        && (!('levitate' in data.project) || data.project.levitate is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlayerPresence(data, sessionId) {
      return data.keys().hasAll([
          'sessionId', 'ownerUid', 'displayName', 'x', 'y', 'z',
          'yaw', 'pose', 'moveSpeed', 'equippedAuraId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'sessionId', 'ownerUid', 'displayName', 'x', 'y', 'z',
          'yaw', 'pose', 'moveSpeed', 'equippedAuraId', 'updatedAt'
        ])
        && isValidId(data.sessionId)
        && data.sessionId == sessionId
        && isValidId(data.ownerUid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 24
        && data.x is number && data.x >= -80 && data.x <= 80
        && data.y is number && data.y >= -5 && data.y <= 60
        && data.z is number && data.z >= -80 && data.z <= 80
        && data.yaw is number && data.yaw >= -100 && data.yaw <= 100
        && data.pose in ['idle', 'walk', 'jump', 'levitate', 'levitate_walk']
        && data.moveSpeed is number && data.moveSpeed >= 0 && data.moveSpeed <= 3
        && data.equippedAuraId is string && data.equippedAuraId.size() <= 128
        && data.updatedAt is timestamp;
    }

    match /rollPool/{auraId} {
      // Public non-PII game catalog readable on any device (including GitHub Pages)
      allow get: if isValidId(auraId);
      allow list: if resource.data.id is string && resource.data.enabled is bool;

      allow create: if isAdmin()
        && isValidId(auraId)
        && isValidRollPoolAura(incoming(), auraId)
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(auraId)
        && isValidRollPoolAura(incoming(), auraId)
        && incoming().id == existing().id
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'description', 'enabled', 'baseOdds',
          'classification', 'project', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(auraId);
    }

    match /players/{sessionId} {
      // Public non-PII world coordinates/pose/auraId so everyone in the shared server sees each other
      allow get: if isValidId(sessionId);
      allow list: if resource.data.sessionId is string
        && resource.data.ownerUid is string
        && resource.data.displayName is string;

      allow create: if isVerified()
        && isValidId(sessionId)
        && isValidPlayerPresence(incoming(), sessionId)
        && incoming().ownerUid == request.auth.uid
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(sessionId)
        && isValidPlayerPresence(incoming(), sessionId)
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().sessionId == existing().sessionId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'x', 'y', 'z', 'yaw',
          'pose', 'moveSpeed', 'equippedAuraId', 'updatedAt'
        ]);

      allow delete: if isValidId(sessionId)
        && isVerified()
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /admins/{userId} {
      allow get: if isAdmin() && isValidId(userId);
      allow list: if isAdmin() && resource.data.uid is string;
      allow create: if isAdmin()
        && isValidId(userId)
        && incoming().keys().hasAll(['uid', 'createdAt'])
        && incoming().keys().hasOnly(['uid', 'createdAt'])
        && incoming().uid == userId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
