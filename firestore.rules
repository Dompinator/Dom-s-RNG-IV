rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'codompic@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidRollPoolAura(data, auraId) {
      return data.keys().hasAll([
          'id', 'name', 'description', 'enabled', 'baseOdds',
          'classification', 'authorUid', 'project', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'description', 'enabled', 'baseOdds',
          'classification', 'authorUid', 'project', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == auraId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 64
        && data.description is string && data.description.size() <= 240
        && data.enabled is bool
        && data.baseOdds is number && data.baseOdds >= 1 && data.baseOdds <= 1000000000000
        && data.classification in ['Standard', 'Epic', 'Legendary', 'Mythic']
        && isValidId(data.authorUid)
        && data.project is map
        && data.project.keys().hasAll(['id', 'name', 'layers', 'rarity'])
        && data.project.layers is list && data.project.layers.size() <= 64
        && (data.project.layers.size() == 0 || data.project.layers[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /rollPool/{auraId} {
      // Public non-PII game catalog readable on any device (including GitHub Pages)
      allow get: if isValidId(auraId);
      allow list: if resource.data.id is string && resource.data.enabled is bool;

      allow create: if isAdmin()
        && isValidId(auraId)
        && isValidRollPoolAura(incoming(), auraId)
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(auraId)
        && isValidRollPoolAura(incoming(), auraId)
        && incoming().id == existing().id
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'description', 'enabled', 'baseOdds',
          'classification', 'project', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(auraId);
    }

    match /admins/{userId} {
      allow get: if isAdmin() && isValidId(userId);
      allow list: if isAdmin() && resource.data.uid is string;
      allow create: if isAdmin()
        && isValidId(userId)
        && incoming().keys().hasAll(['uid', 'createdAt'])
        && incoming().keys().hasOnly(['uid', 'createdAt'])
        && incoming().uid == userId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
